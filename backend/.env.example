# Cấu hình API Key dịch vụ AI (Tuyệt đối không đẩy file .env thật lên Git)
OPENAI_API_KEY=
AI_MOCK_MODE=True
AI_MODEL_NAME=gpt-4o-mini

# Cấu hình Cơ sở dữ liệu và Khóa bí mật JWT
DATABASE_URL=sqlite:///./insurtech_database.db
SECRET_KEY=insurtech_secret_jwt_key_2026_very_secure
ACCESS_TOKEN_EXPIRE_MINUTES=1440
